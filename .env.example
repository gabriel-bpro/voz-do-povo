# Postgres connection string used by the api and worker services.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Port the api service listens on (default 8080).
PORT=8080

# Web app: where to reach the api service (server-side only).
API_HOST=localhost
API_PORT=8080

# Portal da Transparência API key — enables the keyed emendas sync path
# (optional; bulk spreadsheet fallback works without it).
# Sign up: https://www.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# GCP service-account JSON key (single line) for Base dos Dados BigQuery
# access — needed only for the TSE sync (patrimony + campaign financing).
GCP_SERVICE_ACCOUNT_JSON=
